# Porta do servidor backend
PORT=3001

# Ambiente: development | production
NODE_ENV=development

# Chave da API Gemini (Google AI Studio)
GEMINI_API_KEY=sua_chave_aqui_do_google_ai_studio

# Origens permitidas para CORS (separadas por vírgula)
# Em produção, use o domínio real. Em desenvolvimento, localhost:5173 é incluído automaticamente.
CORS_ORIGIN=http://localhost:5173

# Diretório para persistência de dados (users.json, sessions.json)
# Padrão: ./data/
# DATA_DIR=./data
